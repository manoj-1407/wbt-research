From: VoxBridge Research <research@voxbridge.local>
Date: Thu, 23 Oct 2026 00:00:00 +0000
Subject: [PATCH] block/blk-wbt: hold depth on LAT_UNKNOWN_WRITES when read latency elevated

When write completions are sparse (fewer than RWB_MIN_WRITE_SAMPLES = 3
per 100 ms window), WBT classifies the measurement window as
LAT_UNKNOWN_WRITES and calls scale_up(), which allows the write queue
depth to increase (potentially going negative, further boosting writes).

For a pure write-only workload, this is the right response: there is no
read latency evidence, so loosening the throttle is reasonable.

However, this is the wrong response when concurrent reads ARE being
sampled in the same window and their minimum observed latency already
exceeds rwb->min_lat_nsec (the configured target). In that situation,
WBT has positive evidence that the device is struggling with read latency,
but it discards that evidence because the write sample count fell below
RWB_MIN_WRITE_SAMPLES and classifies the whole window as LAT_UNKNOWN_WRITES
instead of LAT_EXCEEDED.

The result: the very window in which read latency is already elevated
can trigger a scale_up(), pushing interference in the wrong direction.

This patch adds a guard at the top of the LAT_UNKNOWN_WRITES branch:

  if (cb->stat[READ].nr_samples &&
      cb->stat[READ].min > rwb->min_lat_nsec) {
      trace_wbt_guard(..., "hold");
      break;
  }

This condition fires only when:
  1. At least one read was sampled in the current 100 ms window, AND
  2. The minimum read latency in that sample exceeds the configured target.

When the condition holds, the controller conservatively holds its current
depth (break) rather than scaling up write limits. When the condition does
not hold (no read samples or read latency is within target), normal scale_up()
proceeds.

A dedicated tracepoint TRACE_EVENT(wbt_guard) is added to provide unambiguous,
in-kernel observability into guard evaluation, read sample count, minimum
latency, and controller decision.

Signed-off-by: VoxBridge Research <research@voxbridge.local>
---
 block/blk-wbt.c            | 21 +++++++++++++++++++--
 include/trace/events/wbt.h | 41 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/block/blk-wbt.c b/block/blk-wbt.c
index aaaaaaa..bbbbbbb 100644
--- a/block/blk-wbt.c
+++ b/block/blk-wbt.c
@@ -448,10 +448,27 @@ static void wb_timer_fn(struct blk_stat_callback *cb)
 	case LAT_UNKNOWN_WRITES:
 		/*
 		 * We started a the center step, but don't have a valid
 		 * read/write sample, but we do have writes going on.
 		 * Allow step to go negative, to increase write perf.
+		 *
+		 * Guard: if concurrent reads are sampled in this window
+		 * and their minimum observed latency already exceeds the
+		 * configured target (rwb->min_lat_nsec), do not scale up
+		 * write depth. Hold depth conservatively.
+		 */
+		if (cb->stat[READ].nr_samples &&
+		    cb->stat[READ].min > rwb->min_lat_nsec) {
+			trace_wbt_guard(rwb->rqos.disk->bdi, rqd->scale_step,
+					cb->stat[READ].nr_samples, cb->stat[READ].min,
+					rwb->min_lat_nsec, 1, "hold");
+			break;
+		}
+
+		trace_wbt_guard(rwb->rqos.disk->bdi, rqd->scale_step,
+				cb->stat[READ].nr_samples, cb->stat[READ].min,
+				rwb->min_lat_nsec, 0, "scale_up");
 		scale_up(rwb);
 		break;
diff --git a/include/trace/events/wbt.h b/include/trace/events/wbt.h
index ccccccc..ddddddd 100644
--- a/include/trace/events/wbt.h
+++ b/include/trace/events/wbt.h
@@ -154,6 +154,47 @@ TRACE_EVENT(wbt_timer,
 	TP_printk("%s: status=%u, step=%d, inflight=%u", __entry->name,
 		  __entry->status, __entry->step, __entry->inflight)
 );
+
+/**
+ * wbt_guard - trace guard evaluation on LAT_UNKNOWN_WRITES
+ * @bdi: backing dev info
+ * @step: current scale step before decision
+ * @r_samples: number of read samples in window
+ * @r_min: minimum read latency in window (nanoseconds)
+ * @target: target latency (nanoseconds)
+ * @guard_fired: whether guard condition was met (1=true, 0=false)
+ * @action: action taken ("hold", "scale_up")
+ */
+TRACE_EVENT(wbt_guard,
+
+	TP_PROTO(struct backing_dev_info *bdi, int step,
+		 unsigned long long r_samples, unsigned long long r_min,
+		 unsigned long long target, int guard_fired, const char *action),
+
+	TP_ARGS(bdi, step, r_samples, r_min, target, guard_fired, action),
+
+	TP_STRUCT__entry(
+		__array(char, name, 32)
+		__field(int, step)
+		__field(unsigned long long, r_samples)
+		__field(unsigned long long, r_min_us)
+		__field(unsigned long long, target_us)
+		__field(int, guard_fired)
+		__string(action, action)
+	),
+
+	TP_fast_assign(
+		strscpy(__entry->name, bdi_dev_name(bdi),
+			ARRAY_SIZE(__entry->name));
+		__entry->step		= step;
+		__entry->r_samples	= r_samples;
+		__entry->r_min_us	= div_u64(r_min, 1000);
+		__entry->target_us	= div_u64(target, 1000);
+		__entry->guard_fired	= guard_fired;
+		__assign_str(action, action);
+	),
+
+	TP_printk("%s: step=%d, r_samples=%llu, r_min=%lluus, target=%lluus, guard_fired=%d, action=%s",
+		  __entry->name, __entry->step, __entry->r_samples,
+		  __entry->r_min_us, __entry->target_us,
+		  __entry->guard_fired, __get_str(action))
+);
+
 #endif /* _TRACE_WBT_H */
